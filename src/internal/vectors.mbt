    {
      graph: {
        name: "path4",
        nodes: 4,
        directed: false,
        arcs: [(0, 1, 1.0), (1, 2, 1.0), (2, 3, 1.0)],
      },
      weight: 3.0,
    },
    {
      graph: {
        name: "square-diagonal",
