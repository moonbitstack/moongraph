name = "moonbitstack/moongraph"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongraph"

license = "Apache-2.0"

keywords = [
  "graph",
  "graphs",
  "digraph",
  "multigraph",
  "graph-theory",
  "graph-algorithms",
  "network-analysis",
  "adjacency-list",
  "adjacency-matrix",
  "csr",
  "shortest-path",
  "dijkstra",
  "bellman-ford",
  "floyd-warshall",
  "a-star",
  "bfs",
  "dfs",
  "topological-sort",
  "spanning-tree",
  "minimum-spanning-tree",
  "max-flow",
  "min-cut",
  "matching",
  "assignment",
  "centrality",
  "pagerank",
  "betweenness",
  "community-detection",
  "louvain",
  "leiden",
  "modularity",
  "clique",
  "graph-coloring",
  "girth",
  "eulerian",
  "euler-circuit",
  "cycle",
  "cycles",
  "weisfeiler-lehman",
  "graph-hash",
  "fingerprint",
  "isomorphism",
  "connected-components",
  "gale-ryser",
  "graphical",
  "digraphical",
  "degree-sequence",
  "erdos-gallai",
  "graphml",
  "graph6",
  "sparse6",
  "dot",
  "gml",
  "pajek",
  "dimacs",
  "edge-list",
  "moonbit",
]

description = "Graphs and graph algorithms for MoonBit: four storage types that share one interface, and the algorithm families that run on all of them."

source = "src"

import {
  "moonbitstack/mooncrypt@0.4.15",
  "moonbitstack/moonrand@0.1.3",
  "moonbitstack/moonstl@0.1.1",
  "moonbitstack/moonxml@0.1.6",
}
