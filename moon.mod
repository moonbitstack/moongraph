name = "moonbitstack/moongraph"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongraph"

license = "Apache-2.0"

keywords = [
  "graph",
  "graphs",
  "digraph",
  "multigraph",
  "graph-theory",
  "graph-algorithms",
  "network-analysis",
  "adjacency-list",
  "adjacency-matrix",
  "csr",
  "shortest-path",
  "dijkstra",
  "bellman-ford",
  "floyd-warshall",
  "a-star",
  "bfs",
  "dfs",
  "topological-sort",
  "spanning-tree",
  "minimum-spanning-tree",
  "max-flow",
  "min-cut",
  "matching",
  "assignment",
  "centrality",
  "pagerank",
  "betweenness",
  "community-detection",
  "louvain",
  "leiden",
  "modularity",
  "clique",
  "graph-coloring",
  "isomorphism",
  "connected-components",
  "gale-ryser",
  "graphical",
  "digraphical",
  "degree-sequence",
  "erdos-gallai",
  "graphml",
  "dot",
  "gml",
  "pajek",
  "dimacs",
  "edge-list",
  "moonbit",
]

description = "Graphs and graph algorithms for MoonBit: four storage types that share one interface, and the algorithm families that run on all of them."

source = "src"

import {
  "moonbitstack/moonrand@0.1.2",
  "moonbitstack/moonstl@0.1.0",
  "moonbitstack/moonxml@0.1.4",
}
